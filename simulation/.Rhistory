library(MASS)
# -------------------- function --------------------
naive_preferred <- function(yA, yB, prefer = c("smaller", "larger"),
conf_level = 0.95) {
prefer <- match.arg(prefer)
nA  <- length(yA)
nB  <- length(yB)
mA  <- mean(yA)
mB  <- mean(yB)
sA2 <- var(yA)
sB2 <- var(yB)
# ------ Step 1: point estimator ------
if (prefer == "smaller") {
est <- min(mA, mB)
chosen_mode <- ifelse(mA <= mB, "A", "B")
} else {
est <- max(mA, mB)
chosen_mode <- ifelse(mA >= mB, "A", "B")
}
# ------ Step 2: plug-in variance ------
sd_xy <- sqrt(sA2/nA + sB2/nB)
Delta <- (mB - mA) / sd_xy
Phi_D  <- pnorm(Delta)
Phi_mD <- pnorm(-Delta)
phi_D  <- dnorm(Delta)
# plug-in expected value of min(X,Y)
Em1 <- mA * Phi_D + mB * Phi_mD - sd_xy * phi_D
# plug-in expected value of min(X,Y)^2
Em2 <- (mA^2 + sA2/nA) * Phi_D +
(mB^2 + sB2/nB) * Phi_mD -
(mA + mB) * sd_xy * phi_D
var_est <- Em2 - Em1^2
se_est  <- sqrt(var_est)
# ------ Step 3: Confidence interval ------
alpha <- 1 - conf_level
z_crit <- qnorm(1 - alpha/2)
lower <- est - z_crit * se_est
upper <- est + z_crit * se_est
# ------ Output style matches your testimator() ------
list(
nA = nA, nB = nB,
mA = mA, mB = mB,
sA2 = sA2, sB2 = sB2,
prefer = prefer,
chosen_mode = chosen_mode,
est = est,
se = se_est,
ci_lower = lower,
ci_upper = upper
)
}
# -------------------- main --------------------
theta_true <- 0
# ---------- scenario 1 (mu_B=0, sigma2_B=1) ----------
