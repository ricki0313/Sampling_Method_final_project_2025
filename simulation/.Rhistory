R <- length(sims_1)
est_vec   <- numeric(R)
lower_vec <- numeric(R)
upper_vec <- numeric(R)
for (r in 1:R) {
fit <- bayes_mixedmode(
sims_1[[r]]$yA,
sims_1[[r]]$yB,
prefer   = "smaller",
cutoff_g = 0.95,
R_post   = 5000
)
est_vec[r]   <- fit$est
lower_vec[r] <- fit$ci_lower
upper_vec[r] <- fit$ci_upper
}
